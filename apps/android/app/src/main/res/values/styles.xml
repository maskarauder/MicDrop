<resources>
  <style name="Theme.MicDrop" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">@color/accent</item>
    <item name="android:colorBackground">@color/app_background</item>
    <item name="android:colorBackgroundFloating">@color/surface</item>
    <item name="android:textColorPrimary">@color/text_primary</item>
    <item name="android:textColorSecondary">@color/text_secondary</item>
    <item name="android:textColorHint">@color/text_secondary</item>
    <item name="android:colorControlNormal">@color/text_secondary</item>
    <item name="android:colorControlActivated">@color/accent</item>
    <item name="android:colorControlHighlight">@color/control_highlight</item>
    <item name="android:buttonStyle">@style/Widget.MicDrop.Button</item>
    <item name="android:alertDialogTheme">@style/Theme.MicDrop.Dialog</item>
    <item name="android:windowBackground">@color/app_background</item>
    <item name="android:statusBarColor">@color/app_background</item>
    <item name="android:navigationBarColor">@color/app_background</item>
    <item name="android:windowSplashScreenBackground">@color/app_background</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>
  <style name="Theme.MicDrop.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">@color/accent</item>
    <item name="android:colorBackgroundFloating">@color/surface</item>
    <item name="android:textColorPrimary">@color/text_primary</item>
    <item name="android:textColorSecondary">@color/text_secondary</item>
    <item name="android:colorControlNormal">@color/text_secondary</item>
    <item name="android:colorControlActivated">@color/accent</item>
    <item name="android:colorControlHighlight">@color/control_highlight</item>
  </style>
  <style name="Widget.MicDrop.Button" parent="android:style/Widget.Material.Button">
    <item name="android:backgroundTint">@color/button_surface</item>
    <item name="android:textColor">@color/on_control</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:minHeight">48dp</item>
  </style>
</resources>
