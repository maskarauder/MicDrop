[Unit]
Description=Refresh MicDrop read-only access to its Caddy certificate
After=caddy.service
Before=micdrop-rendezvous.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/micdrop-rendezvous/service.conf
ExecStart=/usr/bin/python3 /usr/local/libexec/micdrop-caddy-access.py --cert ${CADDY_CERT} --key ${CADDY_KEY}
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caddy
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
RestrictAddressFamilies=AF_UNIX
